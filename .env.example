# =============================================================================
# QIMAM LMS - Production & Development Environment Variables
# Copy this file to .env and configure your values.
# NEVER commit .env with real secrets to version control!
# =============================================================================

# Database Connection (SQLite by default, or PostgreSQL / MySQL for production)
DATABASE_URL="file:./dev.db"

# JWT Secret Key for Secure Authentication (Generate a 64+ char random string in production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Application Public Base URL (Used for Password Reset links and Certificate QR Verification)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default Platform Name fallback
NEXT_PUBLIC_PLATFORM_NAME="أكاديمية م / محمد إبراهيم"

# Optional: AI Assistant API Key
AI_API_KEY=""

# Optional: SMTP Email Configuration (If left blank, mock email logger is used)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"