# =============================================================================
# QIMAM LMS - Production & Development Environment Variables
# Copy this file to .env and configure your values.
# NEVER commit .env with real secrets to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL / Supabase)
# -----------------------------------------------------------------------------
# For Supabase:
# 1. Go to Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# 2. DATABASE_URL: Use the "Transaction" pooler connection string (port 6543 with ?pgbouncer=true)
#    or Direct connection string (port 5432).
#    Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# 3. DIRECT_URL: Use the Direct connection string (port 5432) for running migrations.
#    Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
# Secret key used for signing JWT tokens. In production, use a strong 64+ char random string.
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# -----------------------------------------------------------------------------
# APPLICATION URL & BRANDING
# -----------------------------------------------------------------------------
# The canonical public URL of your application (e.g. https://your-project.vercel.app or https://qimam.com)
# Used for certificate QR verification and password reset links.
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# Default platform name fallback
NEXT_PUBLIC_PLATFORM_NAME="أكاديمية م / محمد إبراهيم"

# -----------------------------------------------------------------------------
# OPTIONAL SERVICES
# -----------------------------------------------------------------------------
# AI Assistant API key (Optional)
AI_API_KEY=""

# SMTP Email Configuration (Optional - if blank, mock email logger is used)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@example.com"